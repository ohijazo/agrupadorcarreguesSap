# ============================================================
# .env de PRODUCCIO — agrupacioCarreguesSAP (Ubuntu, /var/www/agrupacio-carregues-sap)
# ============================================================
# El deploy.sh --first-install genera aquest fitxer automaticament amb
# FLASK_SECRET_KEY i PG_PASSWORD aleatoris. Aquesta copia es la referencia
# de quins camps hi ha d'haver i que vol dir cadascun.
#
# Permisos al servidor:  chown www-data:www-data .env && chmod 600 .env
# NO commitejar mai el .env real.

# --- SAP B1 SQL Server (nomes lectura) ---
SAP_SQL_SERVER=AE01SAPSQL.Agrienergia.local
SAP_SQL_DATABASE=DB_FARIN_TEST
SAP_SQL_USER=sa
SAP_SQL_PASSWORD=CANVIA_AQUESTA_CONTRASENYA

# Alias compatibles amb el codi original (app.py entén tant SAP_* com SQL_*)
SQL_SERVER=AE01SAPSQL.Agrienergia.local
SQL_DATABASE=DB_FARIN_TEST
SQL_USER=sa
SQL_PASSWORD=CANVIA_AQUESTA_CONTRASENYA

# --- Ruta a l'app germana SAP (motor de calcul d'embalatges) ---
# app.py insereix aquest path a sys.path abans d'importar `motor`, i a mes
# carrega el .env d'aquest directori com a fallback.
PREPARACIO_PATH=/var/www/comandes-venda-sap

# KAIS_APP_PATH NO va aqui: el passa la unitat systemd
# (Environment=KAIS_APP_PATH=/var/www/comandes-venda).
# El _bootstrap.py de comandes-venda-sap l'usa per resoldre els moduls
# compartits (models/regles/mailer) del Kais canonic. Compte: el .env de
# comandes-venda-sap TAMPOC el defineix — al servidor cada servei se'l passa
# per Environment=. Com que nosaltres importem motor.py dins del nostre
# proces, l'hem de passar nosaltres; sense ell, /health diu motor: false.

# --- Seguretat administracio ---
ADMIN_KEY=CANVIA_AQUESTA_CLAU

# --- PostgreSQL (persistencia d'agrupacions, usuaris, audit) ---
# BD separada de la de Kais per evitar col·lisions de carrega_id.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=agrupaciocarregues_sap
PG_USER=app_agrupacions_sap
PG_PASSWORD=CANVIA_AQUESTA_CONTRASENYA
PG_POOL_MIN=1
PG_POOL_MAX=5

# --- Auth ---
AUTH_ENABLED=true
# Generar amb: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=CANVIA_AQUESTA_CLAU

# --- Health ---
EXPOSE_HEALTH_DETAIL=false

# --- Power BI (opcional) ---
PBI_API_KEY=

# --- SAP Service Layer (fase futura d'escriptura, encara no usat) ---
SAP_SL_URL=https://192.168.11.238:50000/b1s/v1
SAP_SL_COMPANY=DB_FARIN_TEST
SAP_SL_USER=OHijazo
SAP_SL_PASSWORD=CANVIA_AQUESTA_CONTRASENYA
SAP_SL_VERIFY_SSL=false
SAP_SL_TIMEOUT=15

# NOTA: PORT no cal aqui. El systemd fixa PORT=50006 i Gunicorn hi fa
# --bind 127.0.0.1:50006 explicitament (el 50005 el te el DeCA).

# ============================================================
# Backend de dades de SAP: SQL Server directe o Service Layer
# ============================================================
# SAP no suporta llegir les seves taules per SQL directe, i les lectures
# s'estan migrant al Service Layer. Les dues implementacions conviuen i es
# commuten des d'aqui: revertir es canviar una linia i reiniciar el servei,
# sense desplegar codi.

# Backend global. Per defecte `sql`.
SAP_BACKEND=sql

# Sobreescriptura per funcio (guanya sobre la global). Permet commutar funcio
# a funcio i revertir-ne una de sola. Funcions disponibles:
#   LLISTAR_CARREGUES, LLISTAR_ESTATS_CARREGUES, LLISTAR_TRANSPORTISTES,
#   CERCAR_ARTICLES, OBTENIR_DESCRIP_ARTICLES, OBTENIR_COMANDES_CARREGA,
#   RESUM_CARREGA
# SAP_BACKEND_LLISTAR_ESTATS_CARREGUES=sl

# Si el Service Layer falla, reintenta per SQL (`off` o `sql`). Util els
# primers dies de cada commutacio. Compte: amaga els defectes del backend nou,
# i per aixo /health compta els cops que salta. Desactivar-lo despres.
SAP_BACKEND_FALLBACK=off

# --- Ajustos de la capa de lectura del Service Layer ---
# Files per pagina. El Service Layer en torna 20 per defecte; aixo puja la
# capcalera Prefer: odata.maxpagesize.
SAP_SL_PAGE_SIZE=1000
# Sostre de files per consulta. Si es passa, LLANCA error en lloc de truncar:
# un volcat incomplet que sembla complet es pitjor que un error.
SAP_SL_MAX_FILES=20000
# Vida de les caches en memoria (segons), per worker.
SAP_SL_CACHE_ARTICLES_TTL=900
SAP_SL_CACHE_TRANSP_TTL=900
# Maxim de capceleres que el llistat es porta d'una finestra de dates. Protegeix
# de convertir un rang ampli en una descarrega de tota la taula.
SL_MAX_CAPCALERES=5000

# --- Agregats per carrega ---
# El llistat llegeix kg_total, num_comandes, palletitzable i is_granel d'una
# taula precalculada a PostgreSQL, perque el Service Layer no pot agregar sobre
# linies de document. Els refresquen els timers
# agrupacio-carregues-sap-agregats{,-complet}.
# Si l'antiguitat passa d'aquest llindar, /health respon 503: un refrescador
# encallat en silenci faria que el llistat servis dades velles sense avisar.
AGREGATS_MAX_ANTIGUITAT_S=900
