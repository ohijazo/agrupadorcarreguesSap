# --- SQL Server (ERP, només lectura) ---
SQL_SERVER=servidor\instancia
SQL_DATABASE=nom_base_dades
SQL_USER=usuari_sql
SQL_PASSWORD=contrasenya_segura

# Ruta absoluta a l'app germana (motor de càlcul d'embalatges).
# La nova app importa motor.py / consultes.py / regles.py / models.py des d'aquí.
PREPARACIO_PATH=P:\preparacioComandesVenda

# --- PostgreSQL (persistència de les agrupacions desades) ---
PG_HOST=labfc.agri-energia.local
PG_PORT=5432
PG_DATABASE=agrupaciocarregues
PG_USER=app_agrupacions
PG_PASSWORD=...
# Mida del pool (per defecte 1-5)
PG_POOL_MIN=1
PG_POOL_MAX=5

# --- Power BI (endpoint /api/pbi/carregues) ---
# Clau secreta que Power BI haurà d'enviar al header X-Api-Key.
# Genera-la amb: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si està buida, l'endpoint retorna 503 (no exposa dades).
PBI_API_KEY=

# --- Health endpoint ---
# Per defecte (producció), /health retorna nomès booleans (ok/db/motor/pg).
# Posa a true només per a depuració local: també retorna missatges d'error.
EXPOSE_HEALTH_DETAIL=false

# --- Autenticació (Phase D de seguretat) ---
# Si AUTH_ENABLED=true, cal login per entrar a la web principal. Crea el
# primer usuari amb:   python scripts/crear_admin.py
# /api/pbi/* i /health queden exempts (tenen la seva pròpia auth via API key).
AUTH_ENABLED=false
# Secret per a signar les cookies de sessió. OBLIGATORI a producció (si no
# està definit s'autogenera al startup, però es perd al reinici → sessions
# invalidades). Genera-la amb: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# --- Impressio d'albarans amb el Crystal de SAP ---
# Servei Windows `serveis/crystal-pdf` instal·lat al servidor de SAP (vegeu el
# seu README). Buit = funcio apagada: no surt la seccio "Albarans de SAP".
CRYSTAL_PDF_URL=
# El mateix Token que hi ha al crystal-pdf.exe.config del servidor de SAP.
CRYSTAL_PDF_TOKEN=
# Segons maxims per PDF (el primer de tots triga uns 6 s).
CRYSTAL_PDF_TIMEOUT=60

# --- Cancel·lar albarans de l'SGA (primera escriptura a SAP) ---
# Va pel Service Layer (SAP_SL_*), sigui quin sigui el backend de lectura.
# Apagat per defecte. Provat a TEST i validat per SEIDOR (vegeu
# docs/DESPLEGAMENT-SAP.md, apartat 10).
CANCELAR_ALBARANS=false
# USERID de SAP (OUSR) dels usuaris de l'SGA: nomes els seus albarans es poden
# cancel·lar des de l'app. 22,23 = SGA1,SGA2.
ALBARANS_SGA_USUARIS=22,23
